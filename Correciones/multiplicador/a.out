#! /usr/bin/env bash
exec /home/digital/miniconda3/envs/digital/bin/vvp -f "$0" "$@" <<'# EOF'
:ivl_version "13.0 (devel)" "(0_8-6859-gf50cc35d2-dirty)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/home/digital/miniconda3/envs/digital/lib/ivl/system.vpi";
:vpi_module "/home/digital/miniconda3/envs/digital/lib/ivl/vhdl_sys.vpi";
:vpi_module "/home/digital/miniconda3/envs/digital/lib/ivl/vhdl_textio.vpi";
:vpi_module "/home/digital/miniconda3/envs/digital/lib/ivl/v2005_math.vpi";
:vpi_module "/home/digital/miniconda3/envs/digital/lib/ivl/va_math.vpi";
S_0x298e7300 .scope module, "RCI_TB" "RCI_TB" 2 1;
 .timescale 0 0;
v0x29936240_0 .net "Out_A", 31 0, v0x2990e490_0;  1 drivers
v0x29936320_0 .var "Shft_Dec", 0 0;
v0x299363c0_0 .var "clk", 0 0;
v0x29936460_0 .var "in_A", 15 0;
v0x29936500_0 .var "load", 0 0;
E_0x29924ab0 .event posedge, v0x2990eac0_0;
S_0x29923730 .scope module, "uut" "RCI" 2 8, 3 2 0, S_0x298e7300;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "load";
    .port_info 2 /INPUT 16 "in_A";
    .port_info 3 /INPUT 1 "Shft_Dec";
    .port_info 4 /OUTPUT 32 "Out_A";
v0x2990e490_0 .var "Out_A", 31 0;
v0x2990e7b0_0 .net "Shft_Dec", 0 0, v0x29936320_0;  1 drivers
v0x2990eac0_0 .net "clk", 0 0, v0x299363c0_0;  1 drivers
v0x2990ee50_0 .net "in_A", 15 0, v0x29936460_0;  1 drivers
v0x2990f2d0_0 .net "load", 0 0, v0x29936500_0;  1 drivers
E_0x29924500 .event negedge, v0x2990eac0_0;
    .scope S_0x29923730;
T_0 ;
    %wait E_0x29924500;
    %load/vec4 v0x2990f2d0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x2990ee50_0;
    %pad/u 32;
    %assign/vec4 v0x2990e490_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x2990e7b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x2990e490_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %assign/vec4 v0x2990e490_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x298e7300;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x299363c0_0, 0, 1;
T_1.0 ;
    %delay 20, 0;
    %load/vec4 v0x299363c0_0;
    %inv;
    %store/vec4 v0x299363c0_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x298e7300;
T_2 ;
    %vpi_call 2 14 "$dumpfile", "RCI_TB.vcd" {0 0 0};
    %vpi_call 2 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x298e7300 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x29936500_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x29936320_0, 0, 1;
    %pushi/vec4 65535, 0, 16;
    %store/vec4 v0x29936460_0, 0, 16;
    %wait E_0x29924ab0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x29936500_0, 0, 1;
    %wait E_0x29924ab0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x29936500_0, 0, 1;
    %wait E_0x29924ab0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x29936320_0, 0, 1;
    %pushi/vec4 6, 0, 32;
T_2.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x29924ab0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x29936320_0, 0, 1;
    %pushi/vec4 43690, 0, 16;
    %store/vec4 v0x29936460_0, 0, 16;
    %wait E_0x29924ab0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x29936500_0, 0, 1;
    %wait E_0x29924ab0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x29936500_0, 0, 1;
    %delay 40, 0;
    %vpi_call 2 34 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "RCI_TB.v";
    "RCI.v";
# EOF
